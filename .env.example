NODE_ENV=production
APP_URL=
DATABASE_URL=file:/data/app.db
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OCR_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
MAX_FILE_SIZE_MB=20
MAX_TASK_UPLOAD_MB=50
MAX_CONCURRENT_VERIFICATION_TASKS=1
RAW_FILE_RETENTION_DAYS=7
OCR_MONTHLY_WARNING_LIMIT=170
OCR_MONTHLY_FREE_SAFE_LIMIT=190
OCR_MONTHLY_ABSOLUTE_LIMIT=1000
OCR_ALLOW_PAID_OVERRIDE=true
UPLOAD_DIR=/data/uploads
PROCESSING_DIR=/data/processing
REPORT_DIR=/data/reports
