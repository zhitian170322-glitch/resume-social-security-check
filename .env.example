NODE_ENV=production
APP_URL=
APP_PORT=3100
DATABASE_URL=file:/data/app.db
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OCR_PROVIDER=aliyun
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
MAX_FILE_SIZE_MB=20
MAX_TASK_UPLOAD_MB=50
MAX_CONCURRENT_VERIFICATION_TASKS=1
RAW_FILE_RETENTION_DAYS=7
OCR_MONTHLY_WARNING_LIMIT=170
OCR_MONTHLY_FREE_SAFE_LIMIT=190
OCR_MONTHLY_ABSOLUTE_LIMIT=1000
OCR_ALLOW_PAID_OVERRIDE=true
TEXT_QUALITY_MIN_SCORE=75
OCR_MIN_CONFIDENCE=0.85
EXTRACTION_CONFLICT_THRESHOLD=0.25
RESUME_DUAL_CHANNEL_ON_WARNING=true
ALIYUN_TABLE_OCR_LINELESS=true
OCR_GENERAL_ESTIMATED_COST=0.0825
OCR_TABLE_ESTIMATED_COST=0.0825
DEEPSEEK_ESTIMATED_COST_PER_CALL=0.01
UPLOAD_DIR=/data/uploads
PROCESSING_DIR=/data/processing
REPORT_DIR=/data/reports
